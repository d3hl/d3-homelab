# --- 1Password ------------------------------------------------------------------
# Set OP_SERVICE_ACCOUNT_TOKEN as a sensitive environment variable in the
# HCP Terraform "aap" workspace — never store the token in .tfvars.
#
# 1Password items required:
#   vault d3hl  / proxmox_env  (Login) — URL: endpoint, Password: full API token string
#   vault d3HLPRV / d3_ops     (SSH Key) — public key field: op://d3HLPRV/d3_ops/public key
#
op_vault        = "d3hl"
op_proxmox_item = "proxmox_env"

# --- Proxmox --------------------------------------------------------------------
node_name        = "nodeF"
datastore_id     = "cephVM"
iso_datastore_id = "cFS"

# RHEL 10 KVM guest image URL (Red Hat subscription required).
# Option A — internal HTTP server (recommended):
#   1. Download rhel-10.0-x86_64-kvm.qcow2 from https://access.redhat.com/downloads
#   2. Host it: python3 -m http.server 8080 (or nginx on a homelab VM)
#   3. Set the URL below:
rhel_qcow2_url = "http://10.10.10.X:8080/rhel-10.0-x86_64-kvm.qcow2"

# Option B — pre-signed Red Hat URL (expires; grab from Customer Portal download page):
# rhel_qcow2_url = "https://access.cdn.redhat.com/.../rhel-10.0-x86_64-kvm.qcow2?..."

# Static IP for the AAP server — set a DHCP reservation to match
vm_ip     = "10.10.10.49/24"
vm_gateway = "10.10.10.2"

# Optional: pin a specific VM ID (omit or set to 0 for auto-assign)
#vm_id = 150

# AAP sizing — Red Hat minimums: 4 vCPU / 16 GB RAM / 40 GB disk
cpu_cores    = 8
memory_mb    = 32768
disk_size_gb = 100
